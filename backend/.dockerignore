__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 测试/覆盖率 ----
htmlcov/
.coverage
.coverage.*

# ---- 环境 ----
.env
.venv/
venv/

# ---- 运行时日志 (仅宿主机/容器运行产生, 不进镜像) ----
logs/
