# ============================================================
# Lumos Server 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# ---- 应用基础 ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---- 数据库 ----
# SQLite (开发环境默认)
DATABASE_URL=sqlite+aiosqlite:///./lumos.db
# PostgreSQL (生产环境推荐)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lumos

# ---- AI 模型配置 ----
# 支持 OpenAI 兼容接口 (DeepSeek / Claude / 通义千问)
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# 嵌入模型 (用于 RAG 向量检索)
EMBEDDING_API_KEY=sk-your-embedding-key
EMBEDDING_BASE_URL=https://api.deepseek.com/v1
EMBEDDING_MODEL_NAME=text-embedding-v3

# ---- 多模态视觉模型 (图片/扫描件 OCR) ----
# 复用 OpenAI 兼容接口; DeepSeek 无视觉能力, 默认走通义千问 VL (DashScope 兼容模式)。
# 视觉模型使用独立密钥; 留空则图片自动回退本地 Tesseract OCR。
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL_NAME=qwen-vl-max-latest
# 图片文字抽取策略: auto(优先多模态 LLM, 失败回退 Tesseract) | llm | tesseract
IMAGE_OCR_STRATEGY=auto

# ---- 安全 ----
# API 密钥 (可选, 留空则不启用鉴权)
API_SECRET_KEY=

# ---- 日志 ----
LOG_LEVEL=DEBUG
