# ============================================================
# Lumos Server 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# ---- 应用基础 ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# ---- 数据库 (不再支持 SQLite, 统一使用 MySQL) ----
# MySQL (Docker Compose 宿主端口 3308)
 DATABASE_URL=mysql+aiomysql://lumos:lumos@localhost:3308/lumos
# 回显执行 SQL (调试用; 默认 false, 避免控制台被 SELECT 刷屏)
DATABASE_ECHO=false

# ---- AI 模型配置 ----
# 支持 OpenAI 兼容接口 (DeepSeek / Claude / 通义千问)
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# ---- 嵌入模型 (RAG 向量检索) ----
# 通道: local (默认, sentence-transformers 本地模型, 离线可用) | api (OpenAI 兼容接口)
EMBEDDING_PROVIDER=local
# 本地模型: BAAI/bge-base-zh-v1.5 中文检索 768 维, 首次使用自动下载;
# 切换模型/通道后向量索引按签名自动重建, 无需手工清理
EMBEDDING_MODEL_NAME=BAAI/bge-base-zh-v1.5
# API 嵌入通道 (EMBEDDING_PROVIDER=api 时启用, 如硅基流动 BAAI/bge-m3)
# EMBEDDING_API_KEY=sk-your-embedding-key
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ---- 多模态视觉模型 (图片/扫描件 OCR) ----
# 复用 OpenAI 兼容接口; DeepSeek 无视觉能力, 默认走通义千问 VL (DashScope 兼容模式)。
# 视觉模型使用独立密钥; 留空则图片自动回退本地 Tesseract OCR。
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL_NAME=qwen-vl-max-latest
# 图片文字抽取策略: auto(优先多模态 LLM, 失败回退 Tesseract) | llm | tesseract
IMAGE_OCR_STRATEGY=auto

# ---- MinerU 版面解析 (可选; 不装/不配则自动回退内置 PDF 抽取链路) ----
# 策略: auto(有 MinerU 就用, 不可用回退并记录原因) | mineru(强制, 不可用返回 503) | legacy(关闭)
# Agent 编排模式: multi=多智能体协作（Coordinator 编排 + Verifier 独立复核 + 条件返工，默认）
#                 linear=旧四节点线性流水线（回归对比 / 降级回退）
AGENT_MODE=multi

PDF_PARSER_STRATEGY=auto
# 后端: auto(优先本机 CLI, 合同不出内网) | cli | http(内网自建解析服务)
MINERU_BACKEND=auto
# 本机 MinerU CLI; 留空自动探测 mineru-kit(4.x) / mineru(2.x/3.x)
# MINERU_CLI=mineru-kit
# MINERU_CLI_FLAVOR=auto       # auto | v4 | v2
# MINERU_TIER=standard         # 4.x 档位: flash | basic | standard | advanced
# MINERU_METHOD=auto           # 2.x/3.x 解析方法: auto | txt | ocr
# MINERU_TIMEOUT_SECONDS=180
# 内网解析服务 (backend/scripts/mineru_http_server.py, 默认只监听 127.0.0.1)
# MINERU_HTTP_URL=http://127.0.0.1:8100/v1/file_parse
# MINERU_HTTP_TOKEN=
# 版面图片块 (公章/签名/手写批注) 交给多模态视觉大模型补识, 文本回填原位置
MINERU_VISION_ENRICH=true
MINERU_VISION_MAX_IMAGES=6

# ---- 安全 ----
# API 密钥 (可选, 留空则不启用鉴权)
API_SECRET_KEY=
# JWT 签名密钥 (生产环境务必替换)
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 混合检索 (可选调优, 与代码默认一致即可不设) ----
# 融合前各通道候选数 = top_k × HYBRID_TOP_K_RATIO
# HYBRID_TOP_K_RATIO=2
# RRF 融合参数: score = Σ 1/(k + rank)
# RRF_K=60
# 相关度分数口径: 双通道命中 = 向量权重·余弦相似度 + (1-该值)·BM25归一
# HYBRID_VECTOR_WEIGHT=0.65
# 仅单通道命中时的相关度折扣 (缺少另一通道佐证)
# HYBRID_SINGLE_CHANNEL_FACTOR=0.85

# ---- Milvus (向量库; 不可用时向量通道关闭, 仅保留 BM25 关键词检索) ----
# 两种连接模式 (由 MILVUS_USE_URI 切换):
#   false (默认, 本地/单机): MILVUS_HOST + MILVUS_PORT
MILVUS_USE_URI=false
MILVUS_HOST=localhost
MILVUS_PORT=19530
#   true (托管/Serverless, 如 Zilliz Cloud): MILVUS_URI + MILVUS_TOKEN
# MILVUS_USE_URI=true
# MILVUS_URI=https://in01-xxxx.zillizcloud.com
# MILVUS_TOKEN=your-zilliz-api-key
# 基集合名; 实际集合 = 基名 + embedding 签名后缀 (换模型自动隔离)
MILVUS_COLLECTION=labor_laws

# ---- 对象存储 (S3 兼容) ----
# 本地 MinIO (Docker Compose 宿主端口 9000):
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lumos
MINIO_SECURE=false
# 部署到 PocketBay 时换 Cloudflare R2 (10GB 免费 + 0 出口流量费):
#   MINIO_ENDPOINT=your-accountid.r2.cloudflarestorage.com   # 不带 https:// 前缀
#   MINIO_SECURE=true
# 备选 AWS S3:
#   MINIO_ENDPOINT=s3.amazonaws.com
#   MINIO_SECURE=true

# ---- 日志 ----
LOG_LEVEL=DEBUG
