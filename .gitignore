# =========================
# Lumos 项目 .gitignore
# =========================

# ---- OS Generated ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- IDE ----
.vscode/
*.swp
*.swo
*~
# JetBrains IDE: 共享基础项目配置，忽略个人工作区文件
.idea/*
!.idea/.gitignore
!.idea/lumos.iml
!.idea/modules.xml
!.idea/misc.xml
!.idea/vcs.xml
!.idea/inspectionProfiles/
.idea/inspectionProfiles/profiles_settings.xml
.idea/workspace.xml
.idea/shelf/
.idea/httpRequests/
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/jsLibraryMappings.xml

# ---- Python Backend ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual Environments
.venv/
venv/
ENV/
env/

# PyInstaller
*.manifest
*.spec

# pytest / coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# 检索评测输出 (eval/output/ 下的 JSON/MD 报告)
backend/eval/output/

# 本地 embedding 模型 (HuggingFace, ~470MB, 宿主机预下载后只读挂载, 不入库)
backend/hf_cache/
backend/models/

# 个人简历/非项目文档 (勿入库)
简历_项目介绍.md

# ---- Flutter / Dart ----
# Client-specific ignores are in client/.gitignore

# ---- Environment Variables ----
.env
.env.local
.env.*.local

# ---- Database ----
*.db
*.db-journal
*.sqlite
*.sqlite3
chroma_db/

# ---- Logs ----
logs/
*.log
npm-debug.log*

# ---- Temporary Files ----
tmp/
temp/
*.tmp

# ---- WorkBuddy Agent Memory ----
.workbuddy/

# ---- Vue Web ----
front/node_modules/
front/dist/
front/package-lock.json
