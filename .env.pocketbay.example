# ============================================================
# PocketBay 部署专用环境变量模板
# ============================================================
# 用法:
#   1. 在 PocketBay 控制台 / 环境变量配置页面按本文件逐项填入
#   2. 不要把真实密钥提交到 git 仓库
#   3. 部署后立刻轮换所有密钥
# ============================================================

# ---- 应用基础 ----
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=https://your-project.pocketbay.app
TRUSTED_HOSTS=your-project.pocketbay.app
# 首个企业管理员邮箱。仅首次注册时使用，配置后应移除或保留为受控白名单。
BOOTSTRAP_OWNER_EMAILS=admin@your-company.com

# ---- 数据库 ----
# 推荐: PlanetScale (MySQL 兼容, 改 DATABASE_URL 即可, 零代码改动)
#   例: mysql+aiomysql://用户名:密码@aws.connect.psdb.cloud/lumos?ssl=true
# 备选: Neon (Postgres, 需 schema 调整)
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@HOST/DBNAME?ssl=true
DATABASE_ECHO=false

# ---- LLM (DeepSeek 默认) ----
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# ---- 视觉 LLM (DashScope 通义千问 VL, 图片 OCR 走多模态) ----
LLM_VISION_API_KEY=sk-your-dashscope-key
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL_NAME=qwen-vl-max-latest
IMAGE_OCR_STRATEGY=auto

# ---- Embedding (改 API 通道, 避免 470MB 本地模型) ----
EMBEDDING_PROVIDER=api
# 硅基流动 (免费 200 万 tokens/月, 中文好, 768 维)
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---- Milvus (托管向量库) ----
# 推荐: Zilliz Cloud (Milvus 完全兼容, 改连接方式即可)
MILVUS_USE_URI=true
MILVUS_URI=https://in01-xxxx.zillizcloud.com
MILVUS_TOKEN=your-zilliz-api-key
MILVUS_COLLECTION=labor_laws

# ---- MinIO / 对象存储 (S3 兼容) ----
# 推荐: Cloudflare R2 (10GB 免费 + 0 出口流量费)
#   endpoint 注意: 不带 https:// 前缀 (minio SDK secure=True 时自动加)
MINIO_ENDPOINT=your-accountid.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=your-r2-access-key
MINIO_SECRET_KEY=your-r2-secret-key
MINIO_BUCKET=lumos
MINIO_SECURE=true
# 备选: AWS S3
#   MINIO_ENDPOINT=s3.amazonaws.com
#   MINIO_SECURE=true

# ---- 安全 ----
# 强烈建议用 openssl rand -hex 32 生成。设置后浏览器端需走 JWT，系统集成使用 X-API-Key。
API_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_SECRET_KEY=replace-with-openssl-rand-hex-32
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- 日志 ----
LOG_LEVEL=INFO
DATABASE_ECHO=false
