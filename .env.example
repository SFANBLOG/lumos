# ============================================================
# Lumos 环境变量模板 (仓库根, docker-compose env_file 使用)
# 复制为 .env 后填入真实值; .env 已被 .gitignore 排除, 切勿提交密钥
# ============================================================

# ---- 应用 ----
APP_ENV=development
LOG_LEVEL=DEBUG

# ---- MySQL (docker-compose 专用) ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=lumos
MYSQL_USER=lumos
MYSQL_PASSWORD=lumos

# 后端数据库连接串 (Docker 环境由 compose 注入 MySQL; 不再支持 SQLite)
DATABASE_URL=mysql+aiomysql://lumos:lumos@localhost:3308/lumos
# 是否回显执行 SQL (调试用; 默认 false, 避免控制台/日志被 SELECT 刷屏)
DATABASE_ECHO=false

# ---- LLM (OpenAI 兼容接口) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# ---- 嵌入模型 (RAG 检索的真实向量来源) ----
# provider: local (默认, sentence-transformers 本地模型) | api (OpenAI 兼容 /embeddings)
# 切换模型/通道后, Milvus 集合按 embedding 签名自动隔离重建 (无需手工清理)
EMBEDDING_PROVIDER=local
# 本地模型: bge-base-zh-v1.5 中文检索 768 维
# 目录约定为扁平命名 backend/models/bge-base-zh-v1.5/ (约 400MB, 已 gitignore);
# docker-compose 会将该目录只读挂载到容器 /models 并覆盖为 /models/bge-base-zh-v1.5。
# 缺失时按 HF_ENDPOINT 镜像自动下载; 亦可用 backend/models 下的相对路径写法。
EMBEDDING_MODEL_NAME=bge-base-zh-v1.5
# huggingface.co 受限时的下载镜像
HF_ENDPOINT=https://hf-mirror.com
# API 通道 (EMBEDDING_PROVIDER=api 时启用)
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ---- 混合检索 (可选调优) ----
# HYBRID_TOP_K_RATIO=2   # 融合前各通道候选数 = top_k × 该值
# RRF_K=60               # RRF 融合参数: score = Σ 1/(k + rank)
# HYBRID_VECTOR_WEIGHT=0.65            # 相关度分数中向量权重 (BM25 权重 = 1 - 该值)
# HYBRID_SINGLE_CHANNEL_FACTOR=0.85    # 仅单通道命中时的相关度折扣 (缺少另一通道佐证)

# ---- 多模态视觉模型 (图片/扫描件 OCR) ----
# 未配置密钥时图片自动回退本地 Tesseract OCR
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL_NAME=qwen-vl-max-latest
# 图片文字抽取策略: auto(优先多模态 LLM, 失败回退 Tesseract) | llm | tesseract
IMAGE_OCR_STRATEGY=auto

# ---- MinerU 版面解析 (可选; 不装/不配则自动回退内置 PDF 抽取链路) ----
# 策略: auto(有 MinerU 就用, 不可用回退并记录原因) | mineru(强制, 不可用返回 503) | legacy(关闭)
PDF_PARSER_STRATEGY=auto
# 后端: auto(优先本机 CLI, 合同不出内网) | cli | http(内网自建解析服务)
MINERU_BACKEND=auto
# 本机 MinerU CLI; 留空自动探测 mineru-kit(4.x) / mineru(2.x/3.x)
# MINERU_CLI=mineru-kit
# MINERU_CLI_FLAVOR=auto       # auto | v4 | v2
# MINERU_TIER=standard         # 4.x 档位: flash | basic | standard | advanced
# MINERU_METHOD=auto           # 2.x/3.x 解析方法: auto | txt | ocr
# MINERU_TIMEOUT_SECONDS=180
# 内网解析服务 (backend/scripts/mineru_http_server.py, 默认只监听 127.0.0.1)
# MINERU_HTTP_URL=http://127.0.0.1:8100/v1/file_parse
# MINERU_HTTP_TOKEN=
# 版面图片块 (公章/签名/手写批注) 交给多模态视觉大模型补识, 文本回填原位置
MINERU_VISION_ENRICH=true
MINERU_VISION_MAX_IMAGES=6

# ---- 安全 (生产环境务必替换) ----
# REST API 密钥: 留空则鉴权关闭; 设置后所有请求需带 X-API-Key
API_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 基集合名; 实际集合 = 基名 + embedding 签名后缀 (换模型自动隔离)
MILVUS_COLLECTION=labor_laws

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lumos
MINIO_SECURE=false
