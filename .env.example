# ============================================================
# Lumos 环境变量模板 (仓库根, docker-compose env_file 使用)
# 复制为 .env 后填入真实值; .env 已被 .gitignore 排除, 切勿提交密钥
# ============================================================

# ---- 应用 ----
APP_ENV=development
LOG_LEVEL=DEBUG

# ---- MySQL (docker-compose 专用) ----
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=lumos
MYSQL_USER=lumos
MYSQL_PASSWORD=lumos

# 后端数据库连接串 (Docker 环境由 compose 注入 MySQL; 不再支持 SQLite)
DATABASE_URL=mysql+aiomysql://lumos:lumos@localhost:3308/lumos

# ---- LLM (OpenAI 兼容接口) ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat

# ---- 嵌入模型 (RAG 检索的真实向量来源) ----
# provider: local (默认, sentence-transformers 本地模型) | api (OpenAI 兼容 /embeddings)
# 切换模型/通道后, Milvus/Chroma 集合按 embedding 签名自动隔离重建
EMBEDDING_PROVIDER=local
# 本地模型: 中文多语 384 维, 首次使用自动下载 (~470MB)
EMBEDDING_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
# API 通道 (EMBEDDING_PROVIDER=api 时启用)
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ---- 混合检索 (可选调优) ----
# HYBRID_TOP_K_RATIO=2   # 融合前各通道候选数 = top_k × 该值
# RRF_K=60               # RRF 融合参数: score = Σ 1/(k + rank)

# ---- 多模态视觉模型 (图片/扫描件 OCR) ----
# 未配置密钥时图片自动回退本地 Tesseract OCR
LLM_VISION_API_KEY=
LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL_NAME=qwen-vl-max-latest
# 图片文字抽取策略: auto(优先多模态 LLM, 失败回退 Tesseract) | llm | tesseract
IMAGE_OCR_STRATEGY=auto

# ---- 安全 (生产环境务必替换) ----
# REST API 密钥: 留空则鉴权关闭; 设置后所有请求需带 X-API-Key
API_SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
# 基集合名; 实际集合 = 基名 + embedding 签名后缀 (换模型自动隔离)
MILVUS_COLLECTION=labor_laws

# ---- MinIO ----
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lumos
MINIO_SECURE=false
